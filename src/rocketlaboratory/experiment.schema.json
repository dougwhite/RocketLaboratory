{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dougwhite/RocketLaboratory/experiment.v1",
  "title": "RocketLaboratory experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "duration_steps",
    "preparation",
    "actors"
  ],
  "properties": {
    "schema": {
      "const": "rocketlaboratory.experiment.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "duration_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    },
    "preparation": {
      "enum": [
        "settled_floor",
        "fixed_pose_then_settle"
      ]
    },
    "motion_policy": {
      "enum": [
        "planar",
        "vertical",
        "neutral_baseline"
      ]
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "car_index",
          "segments"
        ],
        "properties": {
          "car_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "segments": {
            "type": "array",
            "maxItems": 7200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_step",
                "duration_steps",
                "controls"
              ],
              "properties": {
                "start_step": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_steps": {
                  "type": "integer",
                  "minimum": 1
                },
                "controls": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "throttle": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "steer": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "pitch": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "yaw": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "roll": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "dodge_forward": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "dodge_strafe": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "handbrake": {
                      "type": "boolean"
                    },
                    "jump": {
                      "type": "boolean"
                    },
                    "activate_boost": {
                      "type": "boolean"
                    },
                    "holding_boost": {
                      "type": "boolean"
                    },
                    "jumped": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
